# --- Nextcloud: used to start it, and by the bot to connect ---
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=<the admin password you chose>
NEXTCLOUD_URL=http://localhost:8080
NEXTCLOUD_USERNAME=kb_service
NEXTCLOUD_APP_PASSWORD=<kb_service's app password>
NEXTCLOUD_PUBLIC_URL=http://localhost:8080

# --- Which AI answers: vertex (Google) or groq ---
LLM_PROVIDER=vertex

# --- Vertex AI (used when LLM_PROVIDER=vertex) ---
VERTEX_MODEL=gemini-3.1-flash-lite
GOOGLE_CLOUD_PROJECT=kb-bot-demo
GOOGLE_CLOUD_LOCATION=global

# --- Groq (used by the Docker containers on your laptop, or if you switch back) ---
GROQ_API_KEY=<your Groq key>
GROQ_MODEL=llama-3.3-70b-versatile

# --- Windows only, for running without Docker ---
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# --- Only for the test scripts in scripts/ ---
ALICE_APP_PASSWORD=<alice's app password>
BOB_APP_PASSWORD=<bob's app password>